# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

*.tsbuildinfo

# GitHub Pages export (published to the gh-pages branch)
/pages-out/

# Hand-off package for the EthosQuest web team (npm run export:release)
/release/

# Team source files, not for the public repo
*.pdf
WhatsApp Image *

# Raw headshots supplied by the team; processed copies live in public/media/team
headshots/
